{
  "name": "pos_tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "pnpm test:unit && pnpm test:version && pnpm test:release",
    "test:unit": "vitest run",
    "test:version": "node --test scripts/validate-version.node-test.mjs",
    "test:release": "node --test scripts/release-config.node-test.mjs scripts/latest-json.node-test.mjs scripts/verify-updater-signatures.node-test.mjs scripts/release-workflow.node-test.mjs scripts/tauri-signature.integration.node-test.mjs",
    "test:signature-integration": "node --test scripts/tauri-signature.integration.node-test.mjs",
    "test:run": "vitest run",
    "validate:version": "node scripts/validate-version.mjs",
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
